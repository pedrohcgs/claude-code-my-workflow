#!/usr/bin/env bash
#
# Pre-commit quality gate for the academic-workflow template.
#
# This closes the "a direct `git commit` bypasses every gate" hole: the
# full backtest suite + the quality score now run on EVERY commit, not
# only when you go through the skill.
#
# Install once per clone:   ./scripts/install-hooks.sh
# (sets core.hooksPath=.githooks so git finds this version-controlled hook.)
#
# It runs two gates against the STAGED changes and aborts the commit on
# failure:
#   1. Surface-sync (ALWAYS): count + enumerative-table-row consistency,
#      skill integrity, model-version currency — deterministic and fast.
#   2. Quality score (>= 80) on staged .qmd / .tex / .R files with rubrics.
#
# Escape hatches (use sparingly; record the reason in the commit message):
#   SKIP_QUALITY_GATE=1 git commit ...   # skip only the quality score
#   git commit --no-verify ...           # skip ALL hooks (last resort)
#
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "pre-commit: not inside a git work tree" >&2
    exit 2
}
cd "$REPO_ROOT" || exit 2

# Validate the STAGED index, not the working tree, by stashing unstaged
# *tracked* changes — but ONLY when it is safe. If any single file has BOTH
# staged and unstaged changes (the `git add -p` workflow), a `stash --keep-index`
# + `pop` round-trip can conflict and write literal conflict markers into your
# file. In that case we skip the stash and validate the working tree as-is (with
# a warning) rather than risk corrupting your work. Untracked files are never
# stashed (avoids slow stashes of large data dirs). A failed pop is loud +
# recoverable, never silently swallowed.
_STASHED=0
# -z: without it git C-quotes a non-ASCII, quote or backslash name
# (".claude/hooks/verifica\303\247\303\243o.py"), and the battery trigger below never
# matched a staged hook spelt that way.
_staged="$(git diff --cached --name-only -z 2>/dev/null | tr '\0' '\n' | sort)"
_unstaged="$(git diff --name-only -z 2>/dev/null | tr '\0' '\n' | sort)"
_overlap="$(comm -12 <(printf '%s\n' "$_staged") <(printf '%s\n' "$_unstaged") | grep -c . || true)"
if [ "${_overlap:-0}" -gt 0 ] 2>/dev/null; then
    echo "ℹ pre-commit: ${_overlap} file(s) have both staged and unstaged changes —" >&2
    echo "  validating the WORKING TREE (not the pure staged index) to avoid a stash conflict." >&2
elif [ -n "$_unstaged" ]; then
    if git stash push --keep-index --quiet --message "pre-commit-gate" 2>/dev/null; then
        _STASHED=1
        trap 'if [ "$_STASHED" = "1" ]; then git stash pop --quiet 2>/dev/null || echo "⚠ pre-commit: could not auto-restore unstaged changes — recover with: git stash pop" >&2; fi' EXIT
    fi
fi

FAIL=0

# The hook battery re-fires every guard hook and is most of the suite's run time.
# Its result can only change when a hook, the settings that wire them, this git
# hook or the battery itself changes — so skip it here when none of those is
# staged. CI runs the full suite on every push; nothing merges unbatteried.
# (A here-string, not `printf | grep -q`: under pipefail, grep -q exiting early
# makes printf die of SIGPIPE on a long staged list, and the test would misfire.)
if grep -E '^(\.claude/hooks/|\.claude/settings[^/]*\.json$|\.githooks/|scripts/hook-battery\.sh$)' \
        >/dev/null <<< "$_staged"; then
    unset BACKTEST_SKIP_HOOK_BATTERY      # a hook is staged: run it, whatever the shell inherited
else
    export BACKTEST_SKIP_HOOK_BATTERY=1
    echo "ℹ pre-commit: no hook, hook-settings or battery change staged — the hook battery is skipped here (CI runs it)."
fi

echo "── pre-commit: backtest (gate suite — see scripts/backtest.sh) ──"
./scripts/backtest.sh
[ $? -ne 0 ] && FAIL=1

if [ "${SKIP_QUALITY_GATE:-0}" = "1" ]; then
    echo ""
    echo "── pre-commit: quality gate SKIPPED (SKIP_QUALITY_GATE=1) ──"
else
    # Staged files that have quality rubrics: added, copied, modified, RENAMED or
    # type-changed. `ACM` alone dropped a file renamed and edited in one commit (git
    # reports it as R), so a syntax-broken script committed unscored. Read
    # NUL-delimited: without -z git C-quotes a non-ASCII, quote or backslash name
    # ("Slides/Aula_introdu\303\247\303\243o.tex"), the suffix match failed on the
    # closing quote, and the file was never scored.
    STAGED=()
    while IFS= read -r -d '' f; do
        case "$f" in *.[qQ][mM][dD]|*.[tT][eE][xX]|*.[rR]) STAGED+=("$f") ;; esac
    done < <(git diff --cached --name-only -z --diff-filter=ACMRT)
    if [ "${#STAGED[@]}" -gt 0 ]; then
        echo ""
        echo "── pre-commit: quality score (>= 80) on ${#STAGED[@]} staged file(s) ──"
        # Score each file individually: portable (no mapfile/bash4), handles
        # any byte in a path, and gives a per-file exit code we can classify.
        for f in "${STAGED[@]}"; do
            if [ ! -f "$f" ]; then
                # Staged, then deleted from the working tree: the commit carries a
                # file this gate cannot read. Skipping it here was a silent pass.
                # A dangling symlink lands here too, and it IS in the working tree:
                # name it as what it is, or the user goes looking for a deleted file.
                if [ -L "$f" ]; then
                    echo "✗ quality gate: '$f' is a symlink whose target is missing or not a file, so it cannot be scored — fix the link or unstage it." >&2
                else
                    echo "✗ quality gate: '$f' is staged but missing from the working tree, so it cannot be scored — restore it or unstage it." >&2
                fi
                FAIL=1
                continue
            fi
            python3 scripts/quality_score.py -- "$f"
            rc=$?
            # quality_score.py: rc 2 = auto-fail (compile/syntax FAILURE), rc 1 =
            # score < 80 (or scorer error / file-not-found). BOTH must block — a
            # file that fails to compile is the worst case, not an "infra error".
            if [ "$rc" -ne 0 ]; then
                echo "✗ quality gate: '$f' failed (rc=$rc — 2=compile/syntax failure, 1=score<80 or scorer error)." >&2
                FAIL=1
            fi
        done
    else
        echo ""
        echo "── pre-commit: no staged .qmd/.tex/.R files to score ──"
    fi
fi

if [ "$FAIL" -ne 0 ]; then
    echo "" >&2
    echo "✗ pre-commit gate failed — commit aborted." >&2
    echo "  Fix the findings above, or (sparingly) bypass with SKIP_QUALITY_GATE=1 / --no-verify." >&2
    exit 1
fi

echo ""
echo "✓ pre-commit gates passed."
exit 0
